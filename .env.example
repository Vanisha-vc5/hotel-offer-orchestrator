# ---------------------------------------------------------------------------
# hotel-offer-orchestrator — copy to .env and adjust. Every value has a safe
# default; docker-compose.yml overrides host names for the container network.
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info
SERVICE_VERSION=1.0.0

# --- HTTP API ---------------------------------------------------------------
PORT=3000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SHUTDOWN_TIMEOUT_MS=10000
HEALTH_CHECK_TIMEOUT_MS=2000

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300
PARTIAL_CACHE_TTL_SECONDS=30

# --- Temporal (local dev server by default) ---------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Temporal Cloud, API-key auth (implies TLS):
TEMPORAL_API_KEY=
# Temporal Cloud, mTLS auth (both paths required together):
TEMPORAL_TLS=false
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=
TEMPORAL_TLS_SERVER_NAME=
TEMPORAL_CONNECT_MAX_ATTEMPTS=30
WORKER_HEALTH_PORT=3001

# --- Workflow / activity tuning ---------------------------------------------
WORKFLOW_EXECUTION_TIMEOUT=30s
SUPPLIER_ACTIVITY_TIMEOUT=4s
SUPPLIER_HTTP_TIMEOUT_MS=3500
SUPPLIER_RETRY_INITIAL_INTERVAL=300ms
SUPPLIER_RETRY_BACKOFF=2
SUPPLIER_RETRY_MAX_INTERVAL=2s
SUPPLIER_RETRY_MAX_ATTEMPTS=3
PERSIST_ACTIVITY_TIMEOUT=5s
PERSIST_RETRY_MAX_ATTEMPTS=5

# --- Supplier endpoints (the mocks are served by the api process) -----------
SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels

# --- Chaos / admin ----------------------------------------------------------
ENABLE_CHAOS=true
# When set, /admin/* requires header `x-admin-token: <value>`.
ADMIN_TOKEN=

# --- docker-compose only ----------------------------------------------------
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
# Host-side published ports (change if something else already uses them)
API_HOST_PORT=3000
REDIS_HOST_PORT=6379
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8080
