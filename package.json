{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Temporal-orchestrated hotel offer aggregation with Redis-side price filtering",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/temporal/worker.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node dist/temporal/bundle.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit --project workflow --project integration",
    "test:unit": "vitest run --project unit",
    "test:workflow": "vitest run --project workflow",
    "test:integration": "vitest run --project integration",
    "test:postman": "newman run postman/HotelOfferOrchestrator.postman_collection.json -e postman/local.postman_environment.json",
    "demo:coalescing": "tsx scripts/coalescing-demo.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@temporalio/activity": "1.26.0",
    "@temporalio/client": "1.26.0",
    "@temporalio/common": "1.26.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@temporalio/testing": "1.26.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "newman": "6.2.3",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
